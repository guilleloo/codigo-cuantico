# Firebase (proyecto existente: codigo-cuantico-app)
# Copia este archivo a .env.local y rellena los valores para conectar Firebase real.
# Mientras estén vacíos, la app usa el proveedor de datos mock (localStorage).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=codigo-cuantico-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=codigo-cuantico-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=codigo-cuantico-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=533300825209
NEXT_PUBLIC_FIREBASE_APP_ID=
